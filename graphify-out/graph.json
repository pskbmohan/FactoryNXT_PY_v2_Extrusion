  "stateMachines": [
    {
      "entity": "WorkOrder",
      "states": ["DRAFT", "RELEASED", "RUNNING", "COMPLETED", "CANCELLED"],
      "transitions": [
        { "from": "DRAFT", "to": "RELEASED", "trigger": "operations:release" },
        { "from": "RELEASED", "to": "RUNNING", "trigger": "operations:first-step execution" },
        { "from": "RUNNING", "to": "COMPLETED", "trigger": "operations:all serial numbers COMPLETED" },
        { "from": "DRAFT", "to": "CANCELLED", "trigger": "operations:cancel" }
      ]
    },
    {
      "entity": "Die",
      "states": ["New", "Inspected", "Testing", "Nitrided", "Available", "(17 other statuses — 22 total)"],
      "transitions": [
        { "from": "New", "to": "Inspected", "trigger": "tool_shop:inspection + ERP post" },
        { "from": "Inspected", "to": "Testing", "trigger": "tool_shop:test + ERP post" },
        { "from": "Testing", "to": "Nitrided", "trigger": "tool_shop:nitriding" },
        { "from": "Nitrided", "to": "Available", "trigger": "tool_shop:release" },
        { "from": "Available", "to": "New", "trigger": "aps_engine:DIE_READY_STATUSES subset" }
      ]
    },
    {
      "entity": "RoutingMaster",
      "states": ["DRAFT", "RELEASED", "OBSOLETE"],
      "transitions": [
        { "from": "DRAFT", "to": "RELEASED", "trigger": "routing_builder:release (requires ≥1 step)" },
        { "from": "RELEASED", "to": "OBSOLETE", "trigger": "routing_builder:obsolete" },
        { "from": "DRAFT", "to": "OBSOLETE", "trigger": "routing_builder:obsolete" }
      ]
    },
    {
      "entity": "Alert",
      "states": ["Open", "Acknowledged", "Closed"],
      "transitions": [
        { "from": "Open", "to": "Acknowledged", "trigger": "kpi_alerts:acknowledge" },
        { "from": "Acknowledged", "to": "Closed", "trigger": "kpi_alerts:close" },
        { "from": "Open", "to": "Closed", "trigger": "kpi_alerts:close" }
      ]
    },
    {
      "entity": "IntegrationJob",
      "states": ["Pending", "Running", "Success", "Failed", "RetryQueued"],
      "transitions": [
        { "from": "Pending", "to": "Running", "trigger": "integrations:execute" },
        { "from": "Running", "to": "Success", "trigger": "adapter:success" },
        { "from": "Running", "to": "Failed", "trigger": "adapter:exception or ERP/PLC NAK" },
        { "from": "Failed", "to": "RetryQueued", "trigger": "integrations:retry" },
        { "from": "RetryQueued", "to": "Running", "trigger": "retry worker" }
      ]
    },
    {
      "entity": "ProcessRun",
      "states": ["RUNNING", "COMPLETED", "FAILED"],
      "transitions": [
        { "from": "RUNNING", "to": "COMPLETED", "trigger": "process_line:finish" },
        { "from": "RUNNING", "to": "FAILED", "trigger": "process_line:abort" }
      ]
    },
    {
      "entity": "Billet",
      "states": ["AVAILABLE", "INSPECTED"],
      "transitions": [
        { "from": "AVAILABLE", "to": "INSPECTED", "trigger": "process_line:inspection" }
      ]
    },
    {
      "entity": "ApsScheduleEntry.constraint_status",
      "states": ["FEASIBLE", "INFEASIBLE"],
      "transitions": [
        { "from": "FEASIBLE", "to": "INFEASIBLE", "trigger": "aps_engine replan when constraint breaks" },
        { "from": "INFEASIBLE", "to": "FEASIBLE", "trigger": "aps_engine replan when constraint relaxes" }
      ]
    },
    {
      "entity": "WattmonUpload",
      "states": ["PENDING", "SUCCESS", "FAILED"],
      "transitions": [
        { "from": "PENDING", "to": "SUCCESS", "trigger": "upload complete" },
        { "from": "PENDING", "to": "FAILED", "trigger": "upload error" }
      ]
    }
  ],
  "workflows": [
    {
      "name": "APS scheduling",
      "file": "app/services/aps_engine.py",
      "description": "Finite-capacity deterministic scheduler. Reads customer orders, resolves machine/die/billet availability, generates work orders, runs greedy scheduler respecting shift calendar + maintenance + changeover constraints, annotates entries with FEASIBLE/INFEASIBLE, persists as versioned schedule. Replanner preserves manually-locked entries.",
